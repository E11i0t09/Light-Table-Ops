{
  "openSetup": {
    "type": "button",
    "text": "Setup wizard",
    "value": "Open"
  },
  "editMode": {
    "type": "checkbox",
    "text": "Edit layout (drag handles in the wallpaper)",
    "value": false
  },
  "layout": {
    "type": "dropdown",
    "text": "Layout",
    "value": 0,
    "items": [
      "Full",
      "Half",
      "Strip"
    ]
  },
  "stripSide": {
    "type": "dropdown",
    "text": "Strip position",
    "value": 0,
    "items": [
      "Right",
      "Left",
      "Bottom"
    ]
  },
  "stripW": {
    "type": "slider",
    "text": "Strip width (Windows pixels)",
    "value": 300,
    "min": 120,
    "max": 900,
    "step": 10
  },
  "iconSide": {
    "type": "dropdown",
    "text": "Desktop icons on",
    "value": 0,
    "items": [
      "Left",
      "Right"
    ]
  },
  "iconCols": {
    "type": "slider",
    "text": "Icon zone: columns (0 = off)",
    "value": 2,
    "min": 0,
    "max": 10,
    "step": 1
  },
  "iconCellW": {
    "type": "slider",
    "text": "Icon zone: column width (Windows pixels)",
    "value": 118,
    "min": 40,
    "max": 300,
    "step": 1
  },
  "iconCellH": {
    "type": "slider",
    "text": "Icon zone: row height (Windows pixels)",
    "value": 93,
    "min": 40,
    "max": 300,
    "step": 1
  },
  "iconGrid": {
    "type": "checkbox",
    "text": "Show icon calibration grid",
    "value": false
  },
  "zoneFrame": {
    "type": "checkbox",
    "text": "Line along the icon zone",
    "value": true
  },
  "taskbar": {
    "type": "slider",
    "text": "Bottom gap for the taskbar (% of height)",
    "value": 2.8,
    "min": 0,
    "max": 8,
    "step": 0.1
  },
  "startView": {
    "type": "dropdown",
    "text": "Main view",
    "value": 0,
    "items": [
      "Map",
      "System",
      "Weather / METAR",
      "Flights"
    ]
  },
  "mapStyle": {
    "type": "dropdown",
    "text": "Map",
    "value": 0,
    "items": [
      "Vector dark (OpenFreeMap)",
      "Satellite (Esri, private use)"
    ]
  },
  "hatch": {
    "type": "checkbox",
    "text": "Red range hatching on the map",
    "value": true
  },
  "place": {
    "type": "textbox",
    "text": "Place (e.g. Hamburg – overrides the wizard, empty = unchanged)",
    "value": ""
  },
  "adsbProxy": {
    "type": "textbox",
    "text": "ADS-B proxy URL (adsb.php)",
    "value": ""
  },
  "range": {
    "type": "slider",
    "text": "Range (km)",
    "value": 100,
    "min": 20,
    "max": 180,
    "step": 10
  },
  "units": {
    "type": "dropdown",
    "text": "Units",
    "value": 0,
    "items": [
      "Aviation (kt, ft)",
      "Metric (km/h, m)"
    ]
  },
  "ui": {
    "type": "slider",
    "text": "Interface size (%)",
    "value": 100,
    "min": 50,
    "max": 150,
    "step": 5
  },
  "dim": {
    "type": "slider",
    "text": "Brightness (%)",
    "value": 100,
    "min": 10,
    "max": 100,
    "step": 5
  },
  "nightMode": {
    "type": "dropdown",
    "text": "Night dimming",
    "value": 0,
    "items": [
      "Auto (after sunset)",
      "On (always dimmed)",
      "Off"
    ]
  },
  "nightLvl": {
    "type": "slider",
    "text": "Night brightness (%)",
    "value": 60,
    "min": 10,
    "max": 100,
    "step": 5
  },
  "anim": {
    "type": "slider",
    "text": "Animation intensity (0 = off)",
    "value": 60,
    "min": 0,
    "max": 100,
    "step": 5
  },
  "fps": {
    "type": "slider",
    "text": "Frame rate limit (fps)",
    "value": 30,
    "min": 5,
    "max": 60,
    "step": 5
  },
  "boot": {
    "type": "checkbox",
    "text": "Boot sequence on start",
    "value": true
  },
  "sensorPort": {
    "type": "textbox",
    "text": "Bridge-Ops-Sensor port (default 47047)",
    "value": "47047"
  }
}